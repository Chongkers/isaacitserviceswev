---
import logo from '../logo.png';
import '../styles/global.css';

// SEO copy is taken verbatim from text already on the site (CLAUDE.md: no AI-written copy)
const {
    title = 'ISAAC IT Services | Intelligent and Secure Technology Solutions in Manila, Philippines',
    description = 'Tailored IT and digital solutions designed to accelerate transformation and drive growth within the Philippine business environment.',
    image = '/og-image.jpg',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);

// Business details as shown in the Contact and Footer sections
const organization = {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    name: 'ISAAC IT Services',
    url: Astro.site?.href,
    logo: new URL(logo.src, Astro.site).href,
    image: new URL('/og-image.jpg', Astro.site).href,
    description: 'Tailored IT and digital solutions designed to accelerate transformation and drive growth within the Philippine business environment.',
    telephone: '+63 917 180 4518',
    address: {
        '@type': 'PostalAddress',
        streetAddress: '12th-Floor Times Plaza Building, UN Avenue',
        addressLocality: 'Manila',
        addressRegion: 'Metro Manila',
        addressCountry: 'PH',
    },
    openingHoursSpecification: {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
        opens: '08:00',
        closes: '17:00',
    },
    areaServed: 'PH',
    sameAs: [
        'https://web.facebook.com/isaacitsolutions/',
        'https://www.linkedin.com/company/isaac-it-services',
    ],
};
---

<!DOCTYPE html>
<html lang="en" class="dark scroll-smooth scroll-pt-16">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#1f1f1f" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ISAAC IT Services" />
    <meta property="og:locale" content="en_PH" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ISAAC IT Services logo" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(organization)} />
    <slot name="head" />

    <link rel="preload" as="image" href="/hex-poster.jpg" />
    <script is:inline>
    if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('isaac-js');
    }
    </script>
</head>
<body class="bg-isaac-dark text-white font-sans antialiased">

<slot />

<script is:inline>
if (document.documentElement.classList.contains('isaac-js')) {
    const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const el = entry.target;
            // Stagger siblings, then drop the delay so hover transitions stay instant
            const delay = Array.prototype.indexOf.call(el.parentElement.children, el) % 3 * 120;
            el.style.transitionDelay = delay + 'ms';
            el.classList.add('is-in');
            setTimeout(() => { el.style.transitionDelay = ''; }, delay + 700);
            revealObserver.unobserve(el);
        });
    }, { threshold: 0.15 });
    document.querySelectorAll('.isaac-card, .isaac-reveal').forEach((el) => revealObserver.observe(el));

    // ── Grid cascade observer (Values & Services headings + card grids) ──────
    const gridObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const grid = entry.target;
            grid.classList.add('is-in');
            // Apply staggered animation-delay to each card child
            Array.from(grid.children).forEach((card, i) => {
                card.style.animationDelay = (i * 100) + 'ms';
            });
            gridObserver.unobserve(grid);
        });
    }, { threshold: 0.08 });

    const headingObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-in');
            headingObserver.unobserve(entry.target);
        });
    }, { threshold: 0.3 });

    document.querySelectorAll('[data-scroll-grid]').forEach((el) => gridObserver.observe(el));
    document.querySelectorAll('[data-scroll-heading]').forEach((el) => headingObserver.observe(el));
}
</script>
</body>
</html>
