<script is:inline>
const track = document.getElementById("carousel-track");
const nextBtn = document.getElementById("nextBtn");
const prevBtn = document.getElementById("prevBtn");
const slides = document.querySelectorAll('#carousel-track figure');

let currentSlide = 0;
let time;
const totalSlides = slides.length;

const dotsWrap = document.getElementById("carousel-dots");
const dots = Array.from(slides, (_, i) => {
    const dot = document.createElement('button');
    dot.type = 'button';
    dot.className = 'isaac-dot';
    dot.setAttribute('aria-label', `Testimonial ${i + 1}`);
    dot.addEventListener('click', () => {
        currentSlide = i;
        moveSlide();
        autoSlide();
    });
    dotsWrap.appendChild(dot);
    return dot;
});

function moveSlide() {
    let movement = currentSlide * 100;
    track.style.transform = `translateX(-${movement}%)`;
    dots.forEach((dot, i) => dot.classList.toggle('is-active', i === currentSlide));
}

// Single source of truth for moving forward
function nextSlide() {
    if (currentSlide < totalSlides - 1) {
        currentSlide++;
    } else {
        currentSlide = 0;
    }
    moveSlide();
}

function prevSlide() {
    if (currentSlide > 0) {
        currentSlide--;
    } else {
        currentSlide = totalSlides - 1;
    }
    moveSlide();
}

// FIX: Just call nextSlide directly to avoid double-incrementing!
nextBtn.addEventListener('click', () => {
    nextSlide();
    autoSlide();
});

prevBtn.addEventListener('click', () => {
    prevSlide();
    autoSlide();
});

function autoSlide() {
    clearInterval(time);
    time = setInterval(nextSlide, 3000); // 3 seconds interval
}

let touchStartX = 0;
let touchEndX = 0;

track.addEventListener('touchstart', (e) => {
    touchStartX = e.changedTouches[0].screenX;
}, { passive: true });

track.addEventListener('touchend', (e) => {
    touchEndX = e.changedTouches[0].screenX;
    handleGesture();
}, { passive: true });

function handleGesture() {
    const swipeThreshold = 50; // Minimum drag pixels to trigger slide
    if (touchStartX - touchEndX > swipeThreshold) {
        // Swiped Left -> Show Next
        nextSlide();
        autoSlide();
    } else if (touchEndX - touchStartX > swipeThreshold) {
        // Swiped Right -> Show Prev
        prevSlide();
        autoSlide();
    }
}

// Initial start
moveSlide();
autoSlide();
</script>
