---
// Round "next section" button at the bottom of a home-page section, continuing the hero's "Learn more"
const { href, label } = Astro.props as { href: string; label: string };
---

<div class="flex justify-center -mt-6 pb-10 lg:-mt-10 lg:pb-14">
    <a href={href} class="isaac-next" aria-label={`Scroll to ${label}`} title={label}>
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
    </a>
</div>
