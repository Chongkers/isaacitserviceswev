---
import logo from '../logo.png';
---

<nav class="bg-black/60 backdrop-blur-md fixed w-full z-40 top-0 start-0 border-b !border-white/10">
  <div class="max-w-screen-xl flex flex-wrap items-center justify-between mx-auto px-6 lg:px-8 py-4">

    <a href="#" class="flex items-center space-x-3">
      <img src={logo.src} class="h-7" alt="ISAAC IT Services logo" width="28" height="28" />
      <span class="self-center text-xl text-white font-black tracking-tighter uppercase">ISAAC IT <span class="text-isaac-orange">SERVICES</span></span>
    </a>
    
    <button data-drawer-target="sidebar-menu" data-drawer-toggle="sidebar-menu" data-drawer-placement="right" type="button" class="inline-flex items-center p-2 w-10 h-10 justify-center text-sm text-gray-400 rounded-lg md:hidden hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-isaac-orange" aria-controls="sidebar-menu">
        <span class="sr-only">Open main menu</span>
        <svg class="w-5 h-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 17 14">
            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1 1h15M1 7h15M1 13h15"/>
        </svg>
    </button>
    
    <div class="items-center justify-between hidden md:flex md:w-auto md:order-1">
      <ul class="flex flex-row gap-10 font-bold items-center justify-center">
        <li><a href="#info" class="block text-white/80 hover:text-isaac-orange transition-colors">Values</a></li>
        <li><a href="#about" class="block text-white/80 hover:text-isaac-orange transition-colors">About Us</a></li>
        <li><a href="#services" class="block text-white/80 hover:text-isaac-orange transition-colors">Services</a></li>
        <li><a href="#contact" class="block rounded-lg bg-isaac-orange px-4 py-2 text-isaac-dark transition hover:brightness-110">Contact Us</a></li>
      </ul>
    </div>

  </div>
</nav>

<div id="sidebar-menu" class="fixed top-0 right-0 z-50 h-screen w-72 max-w-[80vw] p-6 overflow-y-auto transition-transform translate-x-full bg-black backdrop-blur-md md:hidden" tabindex="-1" aria-labelledby="drawer-right-label">
    <button type="button" data-drawer-hide="sidebar-menu" aria-controls="sidebar-menu" class="text-gray-400 bg-transparent hover:bg-white/10 hover:text-white rounded-lg text-sm w-8 h-8 absolute top-4 end-4 inline-flex items-center justify-center">
        <svg class="w-3 h-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14">
            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/>
        </svg>
        <span class="sr-only">Close menu</span>
    </button>

    <div class="py-12">
        <ul class="space-y-6 font-bold text-xl tracking-wide uppercase">
            <li>
                <a href="#info" data-drawer-hide="sidebar-menu" class="block py-2 px-4 text-white/80 hover:text-white rounded-xl hover:bg-white/5 transition-colors">Values</a>
            </li>
            <li>
                <a href="#about" data-drawer-hide="sidebar-menu" class="block py-2 px-4 text-white/80 hover:text-white rounded-xl hover:bg-white/5 transition-colors">About Us</a>
            </li>
            <li>
                <a href="#services" data-drawer-hide="sidebar-menu" class="block py-2 px-4 text-white/80 hover:text-white rounded-xl hover:bg-white/5 transition-colors">Services</a>
            </li>
            <li>
                <a href="#contact" data-drawer-hide="sidebar-menu" class="block py-2 px-4 text-white/80 hover:text-white rounded-xl hover:bg-white/5 transition-colors">Contact Us</a>
            </li>
        </ul>
    </div>
</div>
