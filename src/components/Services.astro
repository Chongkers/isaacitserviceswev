---
import NextSection from './NextSection.astro';
import { services, serviceHref } from '../data/services';
import ServiceDetails from './ServiceDetails.astro';

const expandIcon = '<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m5.25 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15"/></svg>';
---

<section id="services" class="isaac-section bg-isaac-dark">
  <div class="isaac-grid-bg"></div>
  <div class="isaac-glow" style="top: -12rem; right: -12rem;"></div>
  <div class="mx-auto max-w-screen-xl px-6 lg:px-8 py-16 lg:py-24">
      <div class="isaac-reveal max-w-screen-md mb-12 lg:mb-16" data-scroll-heading>
          <span class="isaac-eyebrow">Services</span>
          <h2 class="mb-4 text-3xl md:text-4xl tracking-tight font-extrabold text-white">Our Core Service Domains</h2>
          <p class="text-slate-300 sm:text-xl">Tailored IT and digital solutions designed to accelerate transformation and drive growth within the Philippine business environment.</p>
      </div>
      <!-- Desktop grid (hidden on mobile) -->
      <div class="isaac-balance hidden md:grid gap-6 md:grid-cols-2 lg:grid-cols-3 lg:gap-8" data-scroll-grid>
          {services.map((s) => (
              <div class="isaac-card p-6 lg:p-8" data-service data-href={serviceHref(s)}>
                  <button type="button" class="isaac-expand" aria-label={`Expand ${s.title}`} aria-haspopup="dialog">
                      <Fragment set:html={expandIcon} />
                  </button>
                  <div class="isaac-icon">
                      <svg class="w-5 h-5 lg:w-6 lg:h-6" fill="currentColor" viewBox={s.icon.viewBox} aria-hidden="true" set:html={s.icon.paths} />
                  </div>
                  <h3 class="mb-2 text-xl font-bold text-white">{s.title}</h3>
                  <p class="text-slate-300">{s.summary}</p>
                  <template data-details><ServiceDetails service={s} /></template>
              </div>
          ))}
      </div>

      <!-- Mobile carousel (visible only below md) -->
      <div class="md:hidden">
          <div id="services-track" class="flex gap-4 overflow-x-auto snap-x snap-mandatory scroll-smooth pb-2" style="scrollbar-width:none;">
              {services.map((s) => (
                  <div class="isaac-card p-6 shrink-0 w-[82vw] snap-center" data-service data-href={serviceHref(s)}>
                      <button type="button" class="isaac-expand" aria-label={`Expand ${s.title}`} aria-haspopup="dialog">
                          <Fragment set:html={expandIcon} />
                      </button>
                      <div class="isaac-icon">
                          <svg class="w-5 h-5" fill="currentColor" viewBox={s.icon.viewBox} aria-hidden="true" set:html={s.icon.paths} />
                      </div>
                      <h3 class="mb-2 text-xl font-bold text-white">{s.title}</h3>
                      <p class="text-slate-300">{s.summary}</p>
                      <template data-details><ServiceDetails service={s} /></template>
                  </div>
              ))}
          </div>
          <!-- Dot indicators -->
          <div id="services-dots" class="flex justify-center gap-2 mt-5"></div>
      </div>
  </div>

  <dialog id="service-modal" class="isaac-modal" aria-labelledby="service-modal-title">
      <div class="relative p-6 sm:p-10">
          <button type="button" class="isaac-modal-close" aria-label="Close">
              <svg class="w-3.5 h-3.5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/></svg>
          </button>
          <div id="service-modal-icon" class="isaac-icon"></div>
          <span class="isaac-eyebrow">Services</span>
          <h3 id="service-modal-title" class="mb-4 text-2xl sm:text-3xl font-extrabold tracking-tight"></h3>
          <div id="service-modal-body" class="text-slate-300 text-base sm:text-lg leading-relaxed"></div>
          <div class="mt-8 flex flex-wrap gap-3">
              <a id="service-modal-link" href="#" class="isaac-btn-solid">
                  Learn more
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"></path></svg>
              </a>
              <a href="#contact" class="isaac-btn-outline" data-close-modal>Contact Us</a>
          </div>
      </div>
  </dialog>
  <NextSection href="#about" label="About Us" />
</section>

<script is:inline>
(() => {
    const modal = document.getElementById('service-modal');
    const iconSlot = document.getElementById('service-modal-icon');
    const titleSlot = document.getElementById('service-modal-title');
    const bodySlot = document.getElementById('service-modal-body');
    const linkSlot = document.getElementById('service-modal-link');
    let lastCard = null;

    function openFor(card) {
        lastCard = card;
        iconSlot.innerHTML = card.querySelector('.isaac-icon').innerHTML;
        titleSlot.textContent = card.querySelector('h3').textContent;
        // A card can carry extra detail in a <template data-details>; otherwise reuse its summary
        const details = card.querySelector('template[data-details]');
        bodySlot.innerHTML = details ? details.innerHTML : card.querySelector('p').outerHTML;
        linkSlot.href = card.dataset.href;
        linkSlot.setAttribute('aria-label', 'Learn more about ' + titleSlot.textContent);
        modal.showModal();
    }

    document.querySelectorAll('#services [data-service]').forEach((card) => {
        card.addEventListener('click', () => openFor(card));
    });

    modal.addEventListener('click', (e) => {
        // Clicks on the backdrop land on the dialog element itself
        if (e.target === modal || e.target.closest('.isaac-modal-close, [data-close-modal]')) modal.close();
    });
    modal.addEventListener('close', () => lastCard?.querySelector('.isaac-expand')?.focus({ preventScroll: true }));
})();
</script>

<script is:inline>
(function () {
    var track = document.getElementById('services-track');
    if (!track) return;
    var cards = track.querySelectorAll('.isaac-card');
    var dotsWrap = document.getElementById('services-dots');
    var current = 0;

    var dots = Array.from(cards, function (_, i) {
        var d = document.createElement('button');
        d.type = 'button';
        d.className = 'isaac-dot';
        d.setAttribute('aria-label', 'Service ' + (i + 1));
        d.addEventListener('click', function () { scrollTo(i); });
        dotsWrap.appendChild(d);
        return d;
    });

    function scrollTo(idx) {
        current = idx;
        var card = cards[idx];
        track.scrollTo({ left: card.offsetLeft - track.offsetLeft - 16, behavior: 'smooth' });
        dots.forEach(function (d, i) { d.classList.toggle('is-active', i === idx); });
    }

    track.addEventListener('scroll', function () {
        var mid = track.scrollLeft + track.clientWidth / 2;
        var closest = 0, minDist = Infinity;
        Array.from(cards).forEach(function (c, i) {
            var dist = Math.abs(c.offsetLeft - track.offsetLeft + c.offsetWidth / 2 - mid);
            if (dist < minDist) { minDist = dist; closest = i; }
        });
        if (closest !== current) { current = closest; dots.forEach(function (d, i) { d.classList.toggle('is-active', i === closest); }); }
    }, { passive: true });

    scrollTo(0);
})();
</script>
