---
import NextSection from './NextSection.astro';
---

<section id="info" class="isaac-section bg-isaac-dark text-white">
  <div class="isaac-grid-bg"></div>
  <div class="isaac-glow" style="top: -14rem; right: -12rem;"></div>
  <div class="mx-auto max-w-screen-xl px-6 lg:px-8 py-16 lg:py-24">
      <div class="isaac-reveal max-w-screen-md mb-12 lg:mb-16" data-scroll-heading>
          <span class="isaac-eyebrow">Values</span>
          <h2 class="mb-4 text-3xl md:text-4xl tracking-tight font-extrabold">Empowering Philippine Businesses Through Intelligent and Secure Technology Solutions</h2>
          <p class="text-slate-300 sm:text-xl">At Isaac IT Services, we drive digital transformation by fostering a culture of innovation, maintaining a relentless focus on customer centricity, and building success through seamless collaboration.</p>
      </div>

      <!-- Desktop grid (hidden on mobile) -->
      <div class="isaac-balance hidden md:grid gap-6 md:grid-cols-2 lg:grid-cols-3 lg:gap-8" data-scroll-grid>
          <div class="isaac-card p-6 lg:p-8">
              <div class="isaac-icon">
                  <svg class="w-5 h-5 lg:w-6 lg:h-6" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M3 3a1 1 0 000 2v8a2 2 0 002 2h2.586l-1.293 1.293a1 1 0 101.414 1.414L10 15.414l2.293 2.293a1 1 0 001.414-1.414L12.414 15H15a2 2 0 002-2V5a1 1 0 100-2H3zm11.707 4.707a1 1 0 00-1.414-1.414L10 9.586 8.707 8.293a1 1 0 00-1.414 0l-2 2a1 1 0 101.414 1.414L8 10.414l1.293 1.293a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
              </div>
              <h3 class="mb-2 text-xl font-bold">Collaboration</h3>
              <p class="text-slate-300">We believe that the most complex IT challenges are solved through collective intelligence, treating our clients as partners and our team as a unified engine of shared expertise.</p>
          </div>
          <div class="isaac-card p-6 lg:p-8">
              <div class="isaac-icon">
                <svg class="w-6 h-6" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
                    <path fill-rule="evenodd" d="M3.559 4.544c.355-.35.834-.544 1.33-.544H19.11c.496 0 .975.194 1.33.544.356.35.559.829.559 1.331v9.25c0 .502-.203.981-.559 1.331-.355.35-.834.544-1.33.544H15.5l-2.7 3.6a1 1 0 0 1-1.6 0L8.5 17H4.889c-.496 0-.975-.194-1.33-.544A1.868 1.868 0 0 1 3 15.125v-9.25c0-.502.203-.981.559-1.331ZM7.556 7.5a1 1 0 1 0 0 2h8a1 1 0 0 0 0-2h-8Zm0 3.5a1 1 0 1 0 0 2H12a1 1 0 1 0 0-2H7.556Z" clip-rule="evenodd"/>
                </svg>
              </div>
              <h3 class="mb-2 text-xl font-bold">Customer-Centricity</h3>
              <p class="text-slate-300">Our strategy begins and ends with your business goals; every technical decision we make is measured by its ability to provide tangible value and a seamless experience for your end users.</p>
          </div>
          <div class="isaac-card p-6 lg:p-8">
              <div class="isaac-icon">
                    <svg class="w-6 h-6" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
                        <path fill-rule="evenodd" d="M7.05 4.05A7 7 0 0 1 19 9c0 2.407-1.197 3.874-2.186 5.084l-.04.048C15.77 15.362 15 16.34 15 18a1 1 0 0 1-1 1h-4a1 1 0 0 1-1-1c0-1.612-.77-2.613-1.78-3.875l-.045-.056C6.193 12.842 5 11.352 5 9a7 7 0 0 1 2.05-4.95ZM9 21a1 1 0 0 1 1-1h4a1 1 0 1 1 0 2h-4a1 1 0 0 1-1-1Zm1.586-13.414A2 2 0 0 1 12 7a1 1 0 1 0 0-2 4 4 0 0 0-4 4 1 1 0 0 0 2 0 2 2 0 0 1 .586-1.414Z" clip-rule="evenodd"/>
                    </svg>
                </div>
              <h3 class="mb-2 text-xl font-bold">Innovation</h3>
              <p class="text-slate-300">We don't just maintain the status quo; we proactively integrate emerging technologies and creative problem-solving to ensure your infrastructure is future-proof and ahead of the curve.</p>
          </div>
      </div>

      <!-- Mobile carousel (visible only below md) -->
      <div class="md:hidden" id="values-carousel-wrap">
          <div id="values-track" class="flex gap-4 overflow-x-auto snap-x snap-mandatory scroll-smooth pb-2" style="scrollbar-width:none;">
              <div class="isaac-card p-6 shrink-0 w-[82vw] snap-center">
                  <div class="isaac-icon">
                      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M3 3a1 1 0 000 2v8a2 2 0 002 2h2.586l-1.293 1.293a1 1 0 101.414 1.414L10 15.414l2.293 2.293a1 1 0 001.414-1.414L12.414 15H15a2 2 0 002-2V5a1 1 0 100-2H3zm11.707 4.707a1 1 0 00-1.414-1.414L10 9.586 8.707 8.293a1 1 0 00-1.414 0l-2 2a1 1 0 101.414 1.414L8 10.414l1.293 1.293a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
                  </div>
                  <h3 class="mb-2 text-xl font-bold">Collaboration</h3>
                  <p class="text-slate-300">We believe that the most complex IT challenges are solved through collective intelligence, treating our clients as partners and our team as a unified engine of shared expertise.</p>
              </div>
              <div class="isaac-card p-6 shrink-0 w-[82vw] snap-center">
                  <div class="isaac-icon">
                      <svg class="w-6 h-6" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M3.559 4.544c.355-.35.834-.544 1.33-.544H19.11c.496 0 .975.194 1.33.544.356.35.559.829.559 1.331v9.25c0 .502-.203.981-.559 1.331-.355.35-.834.544-1.33.544H15.5l-2.7 3.6a1 1 0 0 1-1.6 0L8.5 17H4.889c-.496 0-.975-.194-1.33-.544A1.868 1.868 0 0 1 3 15.125v-9.25c0-.502.203-.981.559-1.331ZM7.556 7.5a1 1 0 1 0 0 2h8a1 1 0 0 0 0-2h-8Zm0 3.5a1 1 0 1 0 0 2H12a1 1 0 1 0 0-2H7.556Z" clip-rule="evenodd"/></svg>
                  </div>
                  <h3 class="mb-2 text-xl font-bold">Customer-Centricity</h3>
                  <p class="text-slate-300">Our strategy begins and ends with your business goals; every technical decision we make is measured by its ability to provide tangible value and a seamless experience for your end users.</p>
              </div>
              <div class="isaac-card p-6 shrink-0 w-[82vw] snap-center">
                  <div class="isaac-icon">
                      <svg class="w-6 h-6" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M7.05 4.05A7 7 0 0 1 19 9c0 2.407-1.197 3.874-2.186 5.084l-.04.048C15.77 15.362 15 16.34 15 18a1 1 0 0 1-1 1h-4a1 1 0 0 1-1-1c0-1.612-.77-2.613-1.78-3.875l-.045-.056C6.193 12.842 5 11.352 5 9a7 7 0 0 1 2.05-4.95ZM9 21a1 1 0 0 1 1-1h4a1 1 0 1 1 0 2h-4a1 1 0 0 1-1-1Zm1.586-13.414A2 2 0 0 1 12 7a1 1 0 1 0 0-2 4 4 0 0 0-4 4 1 1 0 0 0 2 0 2 2 0 0 1 .586-1.414Z" clip-rule="evenodd"/></svg>
                  </div>
                  <h3 class="mb-2 text-xl font-bold">Innovation</h3>
                  <p class="text-slate-300">We don't just maintain the status quo; we proactively integrate emerging technologies and creative problem-solving to ensure your infrastructure is future-proof and ahead of the curve.</p>
              </div>
          </div>
          <!-- Dot indicators -->
          <div id="values-dots" class="flex justify-center gap-2 mt-5"></div>
      </div>
  </div>
  <NextSection href="#testimonials" label="Testimonials" />
</section>

<script is:inline>
(function () {
    var track = document.getElementById('values-track');
    if (!track) return;
    var cards = track.querySelectorAll('.isaac-card');
    var dotsWrap = document.getElementById('values-dots');
    var current = 0;

    var dots = Array.from(cards, function (_, i) {
        var d = document.createElement('button');
        d.type = 'button';
        d.className = 'isaac-dot';
        d.setAttribute('aria-label', 'Value ' + (i + 1));
        d.addEventListener('click', function () { scrollTo(i); });
        dotsWrap.appendChild(d);
        return d;
    });

    function scrollTo(idx) {
        current = idx;
        var card = cards[idx];
        track.scrollTo({ left: card.offsetLeft - track.offsetLeft - 16, behavior: 'smooth' });
        dots.forEach(function (d, i) { d.classList.toggle('is-active', i === idx); });
    }

    // Update dots on native scroll snap
    track.addEventListener('scroll', function () {
        var mid = track.scrollLeft + track.clientWidth / 2;
        var closest = 0, minDist = Infinity;
        Array.from(cards).forEach(function (c, i) {
            var dist = Math.abs(c.offsetLeft - track.offsetLeft + c.offsetWidth / 2 - mid);
            if (dist < minDist) { minDist = dist; closest = i; }
        });
        if (closest !== current) { current = closest; dots.forEach(function (d, i) { d.classList.toggle('is-active', i === closest); }); }
    }, { passive: true });

    scrollTo(0);
})();
</script>
